---
import ToolPage from '../../components/ToolPage.astro';
---
<ToolPage
  title="Volumetric Weight Calculator — Metric & Imperial | ShippingMath"
  heading="Volumetric weight calculator"
  eyebrow="International parcel planning"
  description="Work in centimetres and kilograms or inches and pounds. Compare volumetric weight against the package's physical weight without uploading shipment data."
  formula="Volumetric weight = package volume ÷ service divisor"
  explanation={[
    'Volumetric weight and dimensional weight describe the same basic idea: a lightweight carton can occupy enough vehicle or aircraft space to be rated above its scale weight.',
    'International services use different factors and rounding rules. Switch to metric, choose a planning preset, or type the exact divisor from your contract before relying on the result.',
  ]}
  path="/volumetric-weight-calculator/"
/>
