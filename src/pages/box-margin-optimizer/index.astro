---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BoxOptimizer from '../../components/BoxOptimizer.astro';
import { languagePaths } from '../../lib/locales';
import { TOOLS } from '../../lib/tools';
---

<BaseLayout title="Shipping Box Optimizer: Compare Boxes | ShippingMath" description="Compare available shipping boxes, reduce billable weight, estimate monthly savings and calculate the selling price needed for your target margin." canonicalPath="/box-margin-optimizer/" languagePaths={languagePaths.optimizer}>
  <header class="tool-hero optimizer-hero">
    <div class="crumbs"><a href="/">ShippingMath</a> / Box optimizer</div>
    <span class="eyebrow">Free · local · mobile-first</span>
    <h1>Pick the box that protects your margin.</h1>
    <p>Compare your available cartons by fit, billable weight and total packaging cost. See the best valid option immediately.</p>
  </header>
  <BoxOptimizer />
  <article class="content-section optimizer-content">
    <h2>Why the cheapest box is not always the cheapest shipment</h2>
    <p>A low-cost carton can still increase dimensional weight. ShippingMath compares packaging cost and estimated shipping cost together, while rejecting boxes that cannot fit the product even after rotation.</p>
    <h2>What the estimate includes</h2>
    <ul>
      <li>The greater of scale weight and calculated dimensional weight.</li>
      <li>The packaging cost entered for each available box.</li>
      <li>Your estimated carrier cost for each billed weight unit.</li>
      <li>Product cost, other order fees and the target margin when supplied.</li>
    </ul>
    <div class="notice"><strong>Planning estimate:</strong> carrier prices, surcharges, measurement methods and contract rules can differ. Confirm the selected box and actual label price before changing packaging.</div>
  </article>
  <section class="related-tools" aria-labelledby="related-heading">
    <h2 id="related-heading">More free shipping tools</h2>
    <div class="related-grid">
      {TOOLS.filter((tool) => tool.href !== '/box-margin-optimizer/').slice(0, 6).map((tool) => <a href={tool.href}><strong>{tool.name}</strong><span>{tool.blurb}</span></a>)}
    </div>
  </section>
</BaseLayout>
