---
import ToolPage from '../../components/ToolPage.astro';
---
<ToolPage
  title="Billable Weight Calculator — Scale vs DIM Weight | ShipMargin"
  heading="Billable weight calculator"
  eyebrow="Know the weight that matters"
  description="Compare rounded physical weight with dimensional weight and identify which one may control the base shipping charge."
  formula="Estimated billable weight = greater of applicable scale and DIM weight"
  explanation={[
    'The number printed by a scale is not always the weight used for rating a shipment. A service may calculate dimensional weight, apply thresholds and rounding, then compare the applicable result with physical weight.',
    'ShipMargin keeps both figures visible. This helps sellers understand adjustments and test packaging changes before purchasing a label.',
  ]}
  path="/billable-weight-calculator/"
/>
