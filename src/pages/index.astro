---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShippingCalculator from '../components/ShippingCalculator.astro';
import { languagePaths } from '../lib/locales';
import { TOOLS } from '../lib/tools';
---

<BaseLayout title="Shipping Calculator for Sellers: DIM Weight & Margin | ShippingMath" description="Free shipping calculator for online sellers: dimensional weight with 2026 UPS, FedEx and USPS rules, box comparison and order margin. No sign-up." canonicalPath="/" languagePaths={languagePaths.home}>
  <section class="quick-hero">
    <div>
      <span class="eyebrow">Free shipping audit</span>
      <h1>Shipping calculator for <span>online sellers</span></h1>
      <p>Know the weight you will actually pay for. Enter the package size and scale weight to see billable weight, wasted space and margin, with 2026 UPS, FedEx and USPS rules built in.</p>
    </div>
    <div class="quick-trust" aria-label="Product benefits"><span>✓ No sign-up</span><span>✓ Metric + imperial</span><span>✓ Runs in your browser</span></div>
  </section>

  <ShippingCalculator compactIntro />

  <section class="optimizer-callout">
    <div><span class="eyebrow">New · box optimizer</span><h2>Which carton costs less after shipping?</h2><p>Compare every available box by fit, billable weight and estimated monthly savings.</p></div>
    <a class="primary-button" href="/box-margin-optimizer/">Compare my boxes →</a>
  </section>

  <section class="related-tools home-tools">
    <h2>All free shipping tools</h2>
    <div class="related-grid">
      {TOOLS.map((tool) => <a href={tool.href}><strong>{tool.name}</strong><span>{tool.blurb}</span></a>)}
    </div>
  </section>

  <section class="value-section">
    <header>
      <div><span class="eyebrow">Why sellers keep it</span><h2>One quick check before every label.</h2></div>
      <p>Use the answer, share it, and get back to shipping.</p>
    </header>
    <div class="value-grid">
      <article class="value-card"><span>01</span><div><h3>See the billing basis</h3><p>Compare scale, dimensional and billable weight without decoding carrier language.</p></div></article>
      <article class="value-card"><span>02</span><div><h3>Protect the order margin</h3><p>Add the sale and cost details to see whether shipping quietly turned profit into loss.</p></div></article>
      <article class="value-card"><span>03</span><div><h3>Share the evidence</h3><p>Copy the audit, download a clean CSV or send a privacy-safe calculation link.</p></div></article>
    </div>
  </section>
</BaseLayout>
