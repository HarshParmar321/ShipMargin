---
import ToolPage from '../../components/ToolPage.astro';
---
<ToolPage
  title="Batch Shipping Audit: DIM Weight from CSV | ShippingMath"
  heading="Batch shipping audit"
  eyebrow="Private CSV package check"
  description="Paste or choose a CSV to compare scale, dimensional and billable weight across a product catalogue. The file never leaves your browser."
  explanation={[
    'Use the six-column format shown in the workspace. ShippingMath calculates every valid row locally, highlights packages controlled by volume and totals the estimated empty-space weight.',
    'Download the audited rows for packaging review. Customer addresses, names and order details are not required and should not be included in the file.',
  ]}
  defaultTab="batch"
  path="/batch-shipping-audit/"
/>
