---
import ToolPage from '../../components/ToolPage.astro';
---
<ToolPage
  title="Dimensional Weight Calculator — Free DIM & Billable Weight | ShipMargin"
  heading="Dimensional weight calculator"
  eyebrow="DIM weight · free calculator"
  description="Calculate dimensional and billable weight, compare it with scale weight, and see how much empty space may be affecting the shipment."
  formula="DIM weight = length × width × height ÷ divisor"
  explanation={[
    'Dimensional weight converts package volume into a planning weight. Many shipping services compare that value with the physical scale weight and use the larger applicable value.',
    'Select a planning preset or enter the divisor and rounding rule from your own agreement. ShipMargin shows the inputs, rounded dimensions and billing basis so the result is easy to reproduce.',
  ]}
  path="/dimensional-weight-calculator/"
/>
