---
/**
 * Small inline SVG flags. Emoji flags don't render on Windows (they show as "US", "BR"…),
 * so we draw simplified flags instead. No ids, so many can sit on one page.
 */
export type FlagCode = 'us' | 'gb' | 'ca' | 'au' | 'in' | 'br' | 'es' | 'globe';
interface Props { code: FlagCode; class?: string }
const { code, class: className = '' } = Astro.props;
const stripes = Array.from({ length: 7 }, (_, i) => i * 2);
const unionJack = `<rect width="60" height="30" fill="#012169"/><path d="M0 0L60 30M60 0L0 30" stroke="#fff" stroke-width="6"/><path d="M0 0L60 30M60 0L0 30" stroke="#C8102E" stroke-width="2"/><path d="M30 0v30M0 15h60" stroke="#fff" stroke-width="10"/><path d="M30 0v30M0 15h60" stroke="#C8102E" stroke-width="6"/>`;
---
<svg class={`flag ${className}`} viewBox="0 0 30 20" width="22" height="15" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMid slice">
  {code === 'us' && (
    <>
      <rect width="30" height="20" fill="#fff" />
      {stripes.map((i) => <rect y={(i * 20) / 13} width="30" height={20 / 13} fill="#B22234" />)}
      <rect width="13" height={(7 * 20) / 13} fill="#3C3B6E" />
      <g fill="#fff">{[2, 5, 8, 11].flatMap((x) => [2.2, 5.4, 8.6].map((y) => <circle cx={x} cy={y} r=".6" />))}</g>
    </>
  )}
  {code === 'gb' && <svg viewBox="0 0 60 30" width="30" height="20" preserveAspectRatio="xMidYMid slice" set:html={unionJack} />}
  {code === 'au' && (
    <>
      <rect width="30" height="20" fill="#012169" />
      <svg viewBox="0 0 60 30" width="15" height="10" preserveAspectRatio="none" set:html={unionJack} />
      <g fill="#fff"><circle cx="7.5" cy="15" r="1.7" /><circle cx="22.5" cy="16.6" r="1.1" /><circle cx="22.5" cy="4" r="1.1" /><circle cx="18.6" cy="9" r="1.1" /><circle cx="26.2" cy="7.8" r="1.1" /><circle cx="24" cy="11.4" r=".6" /></g>
    </>
  )}
  {code === 'ca' && (
    <>
      <rect width="30" height="20" fill="#fff" />
      <rect width="7.5" height="20" fill="#D52B1E" /><rect x="22.5" width="7.5" height="20" fill="#D52B1E" />
      <path fill="#D52B1E" d="M15 4.2l1 2.1 1.4-.5-.4 2.6 1.8-.6-.5 1.5 1.3.7-3.6 1.8.3 1.5-.9-.3v2.2h-.8V13l-.9.3.3-1.5-3.6-1.8 1.3-.7-.5-1.5 1.8.6-.4-2.6 1.4.5z" />
    </>
  )}
  {code === 'in' && (
    <>
      <rect width="30" height="20" fill="#fff" />
      <rect width="30" height="6.67" fill="#FF9933" /><rect y="13.33" width="30" height="6.67" fill="#138808" />
      <circle cx="15" cy="10" r="2.5" fill="none" stroke="#000080" stroke-width=".6" /><circle cx="15" cy="10" r=".6" fill="#000080" />
    </>
  )}
  {code === 'br' && (
    <>
      <rect width="30" height="20" fill="#009C3B" />
      <path d="M15 2.4 27.4 10 15 17.6 2.6 10z" fill="#FFDF00" />
      <circle cx="15" cy="10" r="4.4" fill="#002776" />
      <path d="M10.8 9.2c2.8-.6 5.9-.2 8.3 1.3" fill="none" stroke="#fff" stroke-width=".7" />
    </>
  )}
  {code === 'es' && (
    <>
      <rect width="30" height="20" fill="#AA151B" />
      <rect y="5" width="30" height="10" fill="#F1BF00" />
    </>
  )}
  {code === 'globe' && (
    <>
      <rect width="30" height="20" fill="#e8e5d8" />
      <g fill="none" stroke="#172018" stroke-width="1"><circle cx="15" cy="10" r="6.5" /><ellipse cx="15" cy="10" rx="2.8" ry="6.5" /><path d="M8.5 10h13M9.6 6.5h10.8M9.6 13.5h10.8" /></g>
    </>
  )}
</svg>
